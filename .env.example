# ── Neon Postgres (persistent director snapshots) ───────────────────────────
# IMPORTANT: use a SEPARATE database for local development than the one
# configured in Render's dashboard for production. Pointing local dev at the
# same DATABASE_URL as production means any local sync run overwrites real
# production data (confirmed happened during this session's testing).
DATABASE_URL=

# ── Upstash Redis (optional legacy fallback) ────────────────────────────────
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Cron auth (/api/cron) ────────────────────────────────────────────────────
CRON_SECRET=

# ── AI ───────────────────────────────────────────────────────────────────────
